# getdeps bootstraps build/fbcode_builder/ from a shallow fbthrift clone;
# it is not tracked in this repo.
build/

# getdeps scratch / CMake build output
__pycache__/
*.pyc

# Local TAAC environment profiles and secrets. Commit only redacted
# `*.example` templates; keep real lab addresses and credentials local.
*.local.env
*.secrets.env
*.secrets.json

# Adopter-owned topology, profiles, and credentials used by local OSS runs.
# Templates live under examples/; the populated copies never belong in Git.
/.taac/
